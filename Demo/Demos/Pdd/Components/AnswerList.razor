@using Demo.Services
@using Demo.Core.Quiz
@namespace Demo.Demos.Pdd.Components

<div class="pdd-answers">
    @foreach (var (answer, index) in QuestionWrapper.Question.Answers.Select((answer, index) => (answer, index)))
    {
        <button class="pdd-answer-button @(GetAnswerCssClass(answer))" @onclick="() => OnAnswerClicked(answer)" disabled="@QuestionWrapper.HasAnswered">
            <div class="pdd-answer-number">@(index + 1)</div><div class="pdd-answer-text"><MultiLanguageText PrimaryLanguageContent="@Content(answer.Text)" SecondaryLanguageContents="@SecondaryContents(answer.Text)" /></div>
        </button>
    }
</div>

@code {
    [Parameter] public required QuestionWrapper QuestionWrapper { get; set; }
    [Parameter] public EventCallback<(QuestionWrapper, QuizAnswer)> OnAnswerSelected { get; set; }
    [Parameter] public required IReadOnlyList<string> Languages { get; set; }
    [Parameter] public string PrimaryLanguage { get; set; } = string.Empty;
    [Parameter] public bool HighlightTerms { get; set; }
    [Inject] public TextTranslationService TranslationService { get; set; } = null!;
    private string Content(LocalizedText text) => TranslationService.GetLocalizedContent(text, PrimaryLanguage, QuestionWrapper.Question.Terms, HighlightTerms);
    private IReadOnlyDictionary<string, string> SecondaryContents(LocalizedText text) => Languages.Where(language => !string.Equals(language, PrimaryLanguage, StringComparison.OrdinalIgnoreCase)).ToDictionary(language => language, language => TranslationService.GetLocalizedContent(text, language, QuestionWrapper.Question.Terms, HighlightTerms));
    private string GetAnswerCssClass(QuizAnswer answer) => !QuestionWrapper.HasAnswered ? string.Empty : QuestionWrapper.SelectedAnswer == answer ? answer.IsCorrect ? "pdd-correct-answer" : "pdd-incorrect-answer" : !QuestionWrapper.SelectedAnswer!.IsCorrect && answer.IsCorrect ? "pdd-correct-answer" : string.Empty;
    private Task OnAnswerClicked(QuizAnswer answer) => QuestionWrapper.HasAnswered ? Task.CompletedTask : OnAnswerSelected.InvokeAsync((QuestionWrapper, answer));
}
