@using Demo.Services
@using Demo.Core.Quiz
@namespace Demo.Demos.Pdd.Components

<div class="pdd-question-block @(QuestionWrapper.HasAnswered ? "answered" : "")">
    <div class="pdd-question-container">
        <div class="pdd-question-text-and-image">
            @if (ImageUrl is not null)
            {
                <div class="pdd-image-container"><img src="@ImageUrl" class="pdd-question-image pdd-question-image--scaled" /><div class="pdd-question-id">@CurrentQuestion.Id</div></div>
            }
            <div class="pdd-question-text"><MultiLanguageText PrimaryLanguageContent="@Content(CurrentQuestion.Text)" SecondaryLanguageContents="@SecondaryContents(CurrentQuestion.Text)" /></div>
        </div>
        <AnswerList QuestionWrapper="@QuestionWrapper" OnAnswerSelected="@OnAnswerSelected" PrimaryLanguage="@PrimaryLanguage" Languages="@Languages" HighlightTerms="@HighlightTerms" />
        @if (CurrentQuestion.Explanation is not null)
        {
            <button class="pdd-btn-show-explanation" @onclick="ToggleExplanation">@((QuestionWrapper.ShowExplanation ? "Hide" : "Show") + " explanation")</button>
            @if (QuestionWrapper.ShowExplanation) { <div class="pdd-rule-description mt-3"><MultiLanguageText PrimaryLanguageContent="@Content(CurrentQuestion.Explanation)" SecondaryLanguageContents="@SecondaryContents(CurrentQuestion.Explanation)" /></div> }
        }
    </div>
</div>

@code {
    [Parameter] public required QuestionWrapper QuestionWrapper { get; init; }
    [Parameter] public EventCallback<(QuestionWrapper, QuizAnswer)> OnAnswerSelected { get; set; }
    [Parameter] public required IReadOnlyList<string> Languages { get; set; }
    [Parameter] public string PrimaryLanguage { get; set; } = string.Empty;
    [Parameter] public required QuizDocument Document { get; set; }
    [Parameter] public bool HighlightTerms { get; set; }
    [Inject] public TextTranslationService TranslationService { get; set; } = null!;
    private QuizQuestion CurrentQuestion => QuestionWrapper.Question;
    private string? ImageUrl => QuestionImageResolver.ResolveQuestionImageUri(Document, CurrentQuestion)?.ToString();
    private string Content(LocalizedText text) => TranslationService.GetLocalizedContent(text, PrimaryLanguage, CurrentQuestion.Terms, HighlightTerms);
    private IReadOnlyDictionary<string, string> SecondaryContents(LocalizedText text) => Languages.Where(language => !string.Equals(language, PrimaryLanguage, StringComparison.OrdinalIgnoreCase)).ToDictionary(language => language, language => TranslationService.GetLocalizedContent(text, language, CurrentQuestion.Terms, HighlightTerms));
    private void ToggleExplanation() => QuestionWrapper.ShowExplanation = !QuestionWrapper.ShowExplanation;
}
