@namespace Demo.Demos.Quiz.Components

<div class="multilanguage-text-container">
    <div class="primary-language-content">@((MarkupString)PrimaryLanguageContent)</div>
    @if (SecondaryLanguageContents.Count > 0)
    {
        <div class="translation-buttons">
            @foreach (var language in SecondaryLanguageContents.Keys)
            {
                <button class="translation-button @(VisibleLanguages.Contains(language) ? "active" : "")" @onclick="() => Toggle(language)" @onclick:stopPropagation="true">@language.ToUpperInvariant()</button>
            }
        </div>
        @foreach (var item in SecondaryLanguageContents.Where(item => VisibleLanguages.Contains(item.Key)))
        {
            <div class="secondary-language-content">@((MarkupString)item.Value)</div>
        }
    }
</div>

@code {
    [Parameter] public string PrimaryLanguageContent { get; set; } = string.Empty;
    [Parameter] public IReadOnlyDictionary<string, string> SecondaryLanguageContents { get; set; } = new Dictionary<string, string>();
    private HashSet<string> VisibleLanguages { get; } = [];
    private void Toggle(string language) { if (!VisibleLanguages.Add(language)) VisibleLanguages.Remove(language); }
}
