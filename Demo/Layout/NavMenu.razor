        </div>
    </nav>
</div>

@implements IDisposable

@code {
    private bool collapseNavMenu = true;
    private bool userExpandedQuiz;

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    private bool ShouldShowQuizSubmenu => userExpandedQuiz || IsQuizStatisticsActive;

    private bool IsQuizStatisticsActive => Navigation
        .ToBaseRelativePath(Navigation.Uri)
        .StartsWith("quiz/statistics", System.StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private void ToggleQuizSubmenu()
    {
        userExpandedQuiz = !userExpandedQuiz;
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
