                        @onclick:stopPropagation="true"
                        aria-expanded="@ShouldShowQuizSubmenu"
                        aria-controls="quiz-submenu">
                    <span class="bi @(ShouldShowQuizSubmenu ? "bi-list-submenu-expanded-nav-menu" : "bi-list-submenu-collapsed-nav-menu")" aria-hidden="true"></span>
